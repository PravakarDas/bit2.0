{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2021",
    "outDir": "./.test-build",
    "rootDir": "./src",
    "noEmit": false,
    "declaration": false,
    "sourceMap": false,
    "incremental": false
  },
  "include": [
    "src/lib/smtp-shared.ts",
    "src/lib/smtp-shared.test.ts",
    "src/lib/crypto.ts",
    "src/lib/crypto.test.ts",
    "src/lib/leave-authorization.ts",
    "src/lib/leave-authorization.test.ts",
    "src/lib/notification-action-authorization.ts",
    "src/lib/notification-action-authorization.test.ts",
    "src/lib/google-drive-config.ts",
    "src/lib/google-drive-config.test.ts",
    "src/lib/google-drive-oauth.ts",
    "src/lib/google-drive-oauth.test.ts",
    "src/lib/pdf-letterhead.ts",
    "src/lib/pdf-letterhead-constants.ts",
    "src/lib/pdf-letterhead.test.ts",
    "src/lib/payslip-filename.ts",
    "src/lib/payslip-filename.test.ts",
    "src/lib/services/payroll-payslip-dispatch.service.ts",
    "src/lib/services/payroll-payslip-dispatch.service.test.ts",
    "src/lib/employee-code.ts",
    "src/lib/payroll-wallet.ts",
    "src/lib/payroll-wallet.test.ts",
    "src/lib/services/payslip-layout.test.ts",
    "src/lib/services/payslip-pdf.service.ts",
    "src/lib/services/payslip-pdf.service.test.ts",
    "src/lib/services/google-drive-client.ts",
    "src/lib/services/google-drive-client.test.ts",
    "src/lib/services/notification-engine/notification.service.ts",
    "src/lib/services/notification-engine/notification.service.test.ts",
    "src/lib/services/notification-engine/queue/**/*.ts",
    "src/lib/services/notification-engine/worker/**/*.ts",
    "src/lib/services/notification-engine/template/**/*.ts",
    "src/lib/services/notification-engine/delivery/**/*.ts",
    "src/lib/services/notification-engine/integration/**/*.ts",
    "src/lib/services/notification-engine/inbox/**/*.ts",
    "src/lib/services/notification-engine/preferences/**/*.ts",
    "src/lib/services/zkt-attendance-sync.service.ts",
    "src/lib/services/zkt-attendance-sync.service.test.ts"
