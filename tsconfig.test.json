{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2021",
    "outDir": "./.test-build",
    "rootDir": "./src",
    "noEmit": false,
    "declaration": false,
    "sourceMap": false,
    "incremental": false
  },
  "include": [
    "src/lib/smtp-shared.ts",
    "src/lib/smtp-shared.test.ts",
    "src/lib/services/notification-engine/notification.service.ts",
    "src/lib/services/notification-engine/notification.service.test.ts",
    "src/lib/services/notification-engine/queue/**/*.ts",
    "src/lib/services/notification-engine/worker/**/*.ts",
    "src/lib/services/notification-engine/template/**/*.ts",
    "src/lib/services/notification-engine/delivery/**/*.ts",
    "src/lib/services/notification-engine/integration/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
