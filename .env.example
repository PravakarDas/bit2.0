# Database
DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>"

# Clerk public keys (safe to expose to client)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Clerk secret keys (server-side only)
CLERK_SECRET_KEY=sk_test_your_secret_key_here
CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ZKTeco Bio Time API Configuration
ZKTECO_BASE_URL=http://103.134.124.164:8090
ZKTECO_USERNAME=the username for zkeco
ZKTECO_PASSWORD=the password for zkeco

# Application Timezone (optional, for cron jobs)
APP_TIMEZONE=Asia/Dhaka

# Cron Job Schedules (Hour:Minute in 24-hour format)
CRON_TIMELINE_HOUR=0
CRON_TIMELINE_MINUTE=1
CRON_ZKTECO_HOUR=11
CRON_ZKTECO_MINUTE=0
CRON_LEAVE_AUTOMATION_HOUR=23
CRON_LEAVE_AUTOMATION_MINUTE=43
