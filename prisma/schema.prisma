generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmployeeStatus {
  // Active type statuses
  ACTIVE
  PROBATION

  // Archived type statuses
  RESIGNED
  TERMINATED
  LAYOFF
  RETIRED
  CONTRACT_ENDED
  SUSPENDED
  ABSCONDED
}

enum Role {
  SUPERADMIN
  HR
  EMPLOYEE
}

enum UserStatus {
  PENDING
  APPROVED
}

enum LoanStatus {
  PENDING
  APPROVED
  ACTIVE
  CLOSED
  DECLINED

  MANAGER_VERIFIED
  MANAGER_REJECTED
}

enum LoanMode {
  AUTO
  MANUAL
}

enum PaymentType {
  EMI
  MANUAL

  MANAGER_VERIFIED
  MANAGER_REJECTED
}

enum ValueType {
  FIXED
  PERCENTAGE
}

enum AllowanceScope {
  FIXED
  FULL_BRANCH
  CUSTOM
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum SalaryChangeReason {
  JOINING
  PROMOTION
  INCREMENT
  ADJUSTMENT
}

enum TransactionType {
  SALARY_CREDIT
  WITHDRAWAL
  REIMBURSEMENT
  ADJUSTMENT
  LOAN_DEDUCTION
  YEARLY_OT_UT_ADJUSTMENT
}

enum LeaveResetPolicy {
  ROSTER_EVERY_YEAR
  FIXED
}

enum DailyRecordStatus {
  PRESENT
  ABSENT
  ON_LEAVE
  WEEKLY_OFF
}

enum OvertimeRequestStatus {
  PENDING
  APPROVED
  DECLINED
  MANAGER_VERIFIED
  MANAGER_REJECTED
}

enum TimelineModificationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model PublicHoliday {
  id                   String   @id @default(cuid())
  name                 String // Holiday name (e.g., "New Year's Day", "Independence Day")
  date                 DateTime // Holiday date
  description          String? // Optional description
  isRecurring          Boolean  @default(false) // Whether it repeats annually
  appliesToAllBranches Boolean  @default(true)
  applicableBranchIds  String[] @default([])
  isActive             Boolean  @default(true) // Can be disabled
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("public_holidays")
}

model Department {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  // Self-referencing for parent-child hierarchy
  parentId String?
  parent   Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Department[] @relation("DepartmentHierarchy")

  // Relations
  designations Designation[]
  users        User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Designation {
  id          String  @id @default(cuid())
  name        String
  description String?
  isActive    Boolean @default(true)

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  // Relations
  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, departmentId])
}

model User {
  id                        String          @id @default(cuid())
  clerkId                   String          @unique
  email                     String          @unique
  firstName                 String?
  lastName                  String?
  imageUrl                  String?
  role                      Role            @default(EMPLOYEE)
  isManager                 Boolean         @default(false)
  status                    UserStatus      @default(PENDING)
  employeeStatus            EmployeeStatus? @default(ACTIVE)
  isArchived                Boolean         @default(false)
  archivedAt                DateTime? // Timestamp when employee was archived
  payrollContinuationMonths Int             @default(2) // Number of months to continue payroll after archive
  walletBalance             Float           @default(0)

  // Current active salary for quick lookups
  baseSalary Float @default(0)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  // Personal Information
  gender      String?
  dateOfBirth DateTime?
  bloodGroup  String?
  nidNumber   String?

  // Contact Information
  phoneNumber   String?
  personalEmail String?

  // Current Address
  currentStreet     String?
  currentCity       String?
  currentState      String?
  currentCountry    String?
  currentPostalCode String?

  // Permanent Address
  permanentStreet     String?
  permanentCity       String?
  permanentState      String?
  permanentCountry    String?
  permanentPostalCode String?

  // Employment Details
  departmentId       String?
  department         Department?  @relation(fields: [departmentId], references: [id])
  designationId      String?
  designation        Designation? @relation(fields: [designationId], references: [id])
  dateOfJoining      DateTime?
  attendanceId       String?
  workingDaysInMonth Int?         @default(22)

  // Emergency Contact
  emergencyContactName         String?
  emergencyContactRelationship String?
  emergencyContactPhone        String?
  emergencyContactEmail        String?
  emergencyContactAddress      String?
  emergencyContactNid          String?

  // Nominee Details
  nomineeName         String?
  nomineeRelationship String?
  nomineePhone        String?
  nomineeEmail        String?
  nomineeNid          String?
  nomineeAddress      String?

  // Banking Information
  bankAccountNumber String?

  // Professional Links
  portfolioLink String?
  githubLink    String?
  linkedinLink  String?
  fiverrLink    String?
  upworkLink    String?

  // Employee Document Links
  loanPapersLink       String?
  nomineesPapersLink   String?
  emergencyContactLink String?
  personalInfoLink     String?

  loans               Loan[]
  medicalClaims       MedicalClaim[]
  medicalEntitlements MedicalEntitlement[]
  salaryPayments      SalaryPayment[]
  salaryHistory       BaseSalary[]
  walletTransactions  WalletTransaction[]
  walletRequests      WalletRequest[]

  // Leave Management Relations
  leaveEntitlements UserLeaveEntitlement[]
  leaveApplications LeaveApplication[]

  // Timeline/Attendance Relations
  timeRecords          DailyTimeRecord[]
  temporaryTimeRecords DailyTimeRecordTemporary[]

  // Overtime Payout Relations
  overtimePayouts OvertimePayout[]

  // Overtime Request Relations
  overtimeRequests OvertimeRequest[]

  // Timeline Modification Request Relations
  timelineModificationRequests   TimelineModificationRequest[]   @relation("TimelineModificationRequester")
  timelineModificationReviewed   TimelineModificationRequest[]   @relation("TimelineModificationReviewer")
  timelineModificationActionLogs TimelineModificationActionLog[] @relation("TimelineModificationActionActor")
  timelineModificationTargetLogs TimelineModificationActionLog[] @relation("TimelineModificationActionTarget")

  // Profile Update Requests
  profileUpdateRequests ProfileUpdateRequest[]

  // Manager verification relations
  loansVerifiedByManager            Loan[]            @relation("LoanManagerVerification")
  overtimeRequestsVerifiedByManager OvertimeRequest[] @relation("OvertimeRequestManagerVerification")

  // Employee Notifications
  employeeNotifications EmployeeNotification[]

  // Breaking Notice Relations
  sentBreakingNotices      BreakingNotice[]          @relation("BreakingNoticeSender")
  targetedBreakingNotices  BreakingNotice[]          @relation("BreakingNoticeTargetUser")
  breakingNoticeRecipients BreakingNoticeRecipient[] @relation("BreakingNoticeRecipientUser")

  // Audit Logs
  auditLogs LeaveAuditLog[]

  // Allowance Relations
  employeeAllowances EmployeeAllowance[]
  payrollOverrides   PayrollAllowanceOverride[]

  // Employee Notes relations
  notesReceived EmployeeNote[]
  notesCreated  EmployeeNote[] @relation("EmployeeNoteCreator")

  // Notification Engine relations (see NotificationEngineDesign.md) — additive only, no new columns on User itself
  notificationJobs           NotificationJob[]
  notificationPreferences    NotificationPreference[]
  // Phase 12 (Notification Center) — same additive convention as the two lines above.
  notificationJobInboxStates NotificationJobInboxState[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WalletTransaction {
  id          String          @id @default(cuid())
  amount      Float
  type        TransactionType
  description String

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

model BaseSalary {
  id            String             @id @default(cuid())
  amount        Float
  effectiveFrom DateTime           @default(now())
  effectiveTo   DateTime?
  reason        SalaryChangeReason @default(JOINING)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Branch {
  id                       String  @id @default(cuid())
  name                     String
  location                 String
  isActive                 Boolean @default(true)
  isLoanApplicationEnabled Boolean @default(true)

  // Timeline/Attendance Settings
  checkInTime   String   @default("09:00") // Format: "HH:MM" (24-hour)
  checkOutTime  String   @default("18:00") // Format: "HH:MM" (24-hour)  
  breakDuration String   @default("01:00") // Format: "HH:MM" (duration)
  weeklyOffDays String[] @default(["SUNDAY"]) // Array of day names: MONDAY, TUESDAY, etc.

  users                   User[]
  bonuses                 BonusType[]
  targetedBreakingNotices BreakingNotice[] @relation("BreakingNoticeTargetBranch")
  pdfTemplate             PdfTemplate?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Blank letterhead PDF used as the background of generated PDFs (e.g. payslips).
// branchId = null is the shared "Default" template used by branches without their own.
// Stored in the database (not on disk) so it survives redeploys; capped at 5 MB on upload.
model PdfTemplate {
  id       String  @id @default(cuid())
  branchId String? @unique
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)

  fileName  String
  sizeBytes Int
  pageWidth  Float // first page size in PDF points
  pageHeight Float
  data      Bytes

  uploadedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SystemSettings {
  id                String   @id @default("global")
  medicalClaimLimit Float    @default(500)
  updatedAt         DateTime @updatedAt
}

model AllowanceType {
  id              String         @id @default(cuid())
  name            String
  amount          Float
  valueType       ValueType // FIXED or PERCENTAGE
  scope           AllowanceScope // FIXED, FULL_BRANCH, CUSTOM
  targetBranchIds String[] // For FULL_BRANCH scope only
  isActive        Boolean        @default(true)

  // Relations
  employeeAllowances EmployeeAllowance[]
  payrollOverrides   PayrollAllowanceOverride[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmployeeAllowance {
  id          String  @id @default(cuid())
  userId      String
  allowanceId String
  isActive    Boolean @default(true)

  // Relations
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  allowance AllowanceType @relation(fields: [allowanceId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([userId, allowanceId])
}

model PayrollAllowanceOverride {
  id           String  @id @default(cuid())
  payrollMonth String // e.g. "2024-01"
  userId       String
  allowanceId  String
  isIncluded   Boolean // true = include, false = exclude
  customAmount Float? // override amount if different from allowance default

  // Relations
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  allowance AllowanceType @relation(fields: [allowanceId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([payrollMonth, userId, allowanceId])
}

model BonusType {
  id       String    @id @default(cuid())
  name     String
  value    Float
  type     ValueType
  isActive Boolean   @default(true)

  branches Branch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MedicalEntitlement {
  id               String @id @default(cuid())
  year             Int
  totalLimit       Float
  remainingBalance Float

  userId String
  user   User   @relation(fields: [userId], references: [id])

  claims    MedicalClaim[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([userId, year])
}

model MedicalClaim {
  id            String      @id @default(cuid())
  amount        Float
  description   String
  attachmentUrl String?
  status        ClaimStatus @default(PENDING)

  // Set when the claim is paid through payroll: what was actually paid (may differ from `amount`)
  // and the payroll month. Admin-added payroll amounts with no claim are stored as their own PAID row.
  paidAmount   Float?
  payrollMonth String?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  medicalEntitlementId String?
  medicalEntitlement   MedicalEntitlement? @relation(fields: [medicalEntitlementId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum SalaryPaymentStatus {
  DRAFT // saved by admin, no money effects applied yet (wallet/medical/loans untouched)
  FINALIZED // payslip sent; wallet cleared, medical marked paid, loan balances updated
}

model SalaryPayment {
  id                   String @id @default(cuid())
  month                String // e.g. "2024-01"
  baseSalary           Float
  totalBonuses         Float
  totalAllowances      Float
  medicalReimbursement Float
  loanDeduction        Float
  walletAdjustment     Float  @default(0)
  netAmount            Float

  // Draft/finalize workflow. Rows that existed before this workflow are FINALIZED.
  status          SalaryPaymentStatus @default(FINALIZED)
  customBonus     Float               @default(0) // one-off bonus for this month, already included in totalBonuses
  customBonusNote String?
  draftInputs     Json? // admin selections behind a DRAFT: bonus ids, EMI switch, manual loan deductions
  payslipSentAt   DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([month, status])
}

model Loan {
  id                 String     @id @default(cuid())
  issuedAmount       Float
  remainingPrincipal Float
  gracePeriodMonths  Int
  totalMonths        Int
  status             LoanStatus @default(PENDING)
  isManuallySeeded   Boolean    @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  emiState      EmiState?
  payments      Payment[]
  reason        String    @default("Personal")
  emiStartMonth Int?
  emiStartYear  Int?
  approvedBy    String?
  adminComments String? // Admin comments during approval
  declineReason String? // Reason for declining the loan
  declinedBy    String? // Admin who declined the loan

  managerVerifiedAt      DateTime?
  managerVerifiedById    String?
  managerVerifiedBy      User?     @relation("LoanManagerVerification", fields: [managerVerifiedById], references: [id])
  managerRejectionReason String?
  managerComments        String?
  adminDeclinedReason    String?
  adminDeclinedAt        DateTime?

  auditLogs AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmiState {
  id           String @id @default(cuid())
  currentEmi   Float
  carryForward Float  @default(0)

  loanId String @unique
  loan   Loan   @relation(fields: [loanId], references: [id])
}

model Payment {
  id           String      @id @default(cuid())
  amount       Float
  type         PaymentType
  payrollMonth String // e.g., "2024-01"

  loanId String
  loan   Loan   @relation(fields: [loanId], references: [id])

  createdAt DateTime @default(now())
}

enum WalletRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model WalletRequest {
  id            String              @id @default(cuid())
  amount        Float
  description   String
  status        WalletRequestStatus @default(PENDING)
  attachmentUrl String?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id           String @id @default(cuid())
  oldEmi       Float?
  newEmi       Float?
  changeReason String

  // Optional linkage for loan-specific logs
  loanId String?
  loan   Loan?   @relation(fields: [loanId], references: [id])

  userId String?

  createdAt DateTime @default(now())
}

model SystemAudit {
  id        String   @id @default(cuid())
  action    String
  details   String
  status    String   @default("SUCCESS")
  createdAt DateTime @default(now())
}

model SystemControlSettings {
  id                         String   @id @default("global")
  appTimezone                String   @default("Asia/Dhaka")
  timelineCronEnabled        Boolean  @default(true)
  timelineCronHour           Int      @default(1)
  timelineCronMinute         Int      @default(24)
  zktecoCronEnabled          Boolean  @default(true)
  zktecoCronMode             String   @default("DAILY") // "DAILY" | "INTERVAL"
  zktecoIntervalMinutes      Int      @default(15)
  zktecoCronHour             Int      @default(11)
  zktecoCronMinute           Int      @default(0)
  leaveAutomationCronEnabled Boolean  @default(true)
  leaveAutomationCronHour    Int      @default(23)
  leaveAutomationCronMinute  Int      @default(43)
  zktecoBaseUrl              String   @default("")
  zktecoUsername             String   @default("")
  zktecoPassword             String   @default("")
  loanMode                   LoanMode @default(AUTO) // Applies to loans approved from now on; existing loans keep their own behaviour
  updatedById                String?
  updatedByEmail             String?
  updatedByRole              String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

model SystemControlChangeLog {
  id             String   @id @default(cuid())
  actorId        String
  actorName      String
  actorEmail     String?
  actorRole      String
  actorIsManager Boolean  @default(false)
  changedFields  String[]
  previousValues Json?
  newValues      Json?
  createdAt      DateTime @default(now())
}

model EmailConfig {
  id                   String   @id @default("global")
  provider             String   @default("GMAIL")
  smtpHost             String   @default("smtp.gmail.com")
  smtpPort             Int      @default(587)
  secure               Boolean  @default(false)
  senderEmail          String   @default("")
  appPasswordEncrypted String   @default("")
  updatedById          String?
  updatedByEmail       String?
  updatedByRole        String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// Google Drive service-account config (Payroll PDF archival) — singleton row,
// same "global" id + encrypted-secret pattern as EmailConfig above.
// serviceAccountEmail + privateKeyEncrypted are the two fields a Google
// service account needs to authenticate (JWT auth, no OAuth consent flow).
// rootFolderId is the Drive folder ID (shared with the service account, or
// inside sharedDriveId) under which the "Payroll" folder tree is found/
// created — a bare service account has no usable personal Drive storage of
// its own, so this anchor must point at a location a human has already
// shared with it.
// Phase 19: authenticationMethod defaults to SERVICE_ACCOUNT so the existing
// singleton row (and every row created before this enum existed) is treated
// as Service Account mode with no data migration and no forced reconnect.
// The four oauth* fields are additive and unused until authenticationMethod
// is switched to OAUTH2 — see GoogleDriveOAuthPlan.md.
enum GoogleDriveAuthMethod {
  SERVICE_ACCOUNT
  OAUTH2
}

model GoogleDriveConfig {
  id                   String                @id @default("global")
  authenticationMethod GoogleDriveAuthMethod @default(SERVICE_ACCOUNT)

  // Service Account fields — unchanged, still the default/only-used path
  // until authenticationMethod is switched to OAUTH2.
  serviceAccountEmail String @default("")
  privateKeyEncrypted String @default("")

  // OAuth 2.0 fields — populated only in OAUTH2 mode. No access-token column:
  // googleapis's OAuth2 client refreshes short-lived access tokens in memory
  // from oauthRefreshTokenEncrypted, so no access token is ever persisted.
  oauthClientId              String  @default("")
  oauthClientSecretEncrypted String  @default("")
  oauthRefreshTokenEncrypted String  @default("")
  oauthConnectedEmail        String?

  sharedDriveId  String? // set only when rootFolderId lives inside a Shared Drive
  rootFolderId   String   @default("")
  rootFolderName String   @default("Payroll")
  updatedById    String?
  updatedByEmail String?
  updatedByRole  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Leave Management Models
model LeaveType {
  id               String           @id @default(cuid())
  name             String           @unique
  allocatedDays    Int // How many days per year
  requiresApproval Boolean          @default(true)
  isActive         Boolean          @default(true)
  leaveResetPolicy LeaveResetPolicy @default(ROSTER_EVERY_YEAR)

  // Branches that can use this leave type (JSON array of branch IDs)
  applicableBranches String @default("[]") // JSON array ["branch1", "branch2"]

  // Relations
  userEntitlements  UserLeaveEntitlement[]
  leaveApplications LeaveApplication[]
  leaveAuditLogs    LeaveAuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserLeaveEntitlement {
  id            String @id @default(cuid())
  year          Int // Calendar year
  allocatedDays Int // Days allocated for this year
  usedDays      Int    @default(0) // Days used so far

  // Relations
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Ensure one entitlement per user per leave type per year
  @@unique([userId, leaveTypeId, year])
}

enum LeaveApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model LeaveApplication {
  id        String                 @id @default(cuid())
  leaveDate DateTime // The date of leave
  reason    String? // Optional reason
  status    LeaveApplicationStatus @default(PENDING)

  // Relations
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])

  // Approval tracking
  approvedBy String? // Admin who approved/rejected
  approvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DailyTimeRecord {
  id     String            @id @default(cuid())
  date   DateTime // The date for this record (date only, no time)
  status DailyRecordStatus @default(PRESENT)

  // Required times (from branch settings or manual override)
  requiredCheckIn   DateTime? // Full DateTime for required check-in
  requiredCheckOut  DateTime? // Full DateTime for required check-out
  requiredBreakTime String? // Duration in HH:MM format (e.g., "01:00")

  // Actual times (to be filled by attendance system or manual entry)
  actualCheckIn   DateTime? // Actual check-in time
  actualCheckOut  DateTime? // Actual check-out time
  actualBreakTime String? // Actual break duration in HH:MM format

  // Calculated fields (computed from above times)
  requiredActiveTime        String? // (requiredCheckOut - requiredCheckIn - requiredBreakTime) in HH:MM
  actualActiveTime          String? // (actualCheckOut - actualCheckIn - actualBreakTime) in HH:MM
  officialOvertimeundertime String? // (actualActiveTime - requiredActiveTime) in +/-HH:MM format - Auto calculated
  requestedOvertime         String? // Overtime approved by admin from employee request in HH:MM format
  requestedOTstart          DateTime? // Employee requested overtime start time
  requestedOTend            DateTime? // Employee requested overtime end time
  overtimeUndertime         String? // Total overtime (officialOvertimeundertime + requestedOvertime) in +/-HH:MM format

  // Late check-in penalty tracking
  lateCheckInMinutes Int?   @default(0)
  lateCheckInPenalty Float? @default(0)

  // Auto leave deduction details
  autoDeductedLeaveType String? // Leave type name that was auto-deducted
  isProcessed           Boolean @default(false) // Whether auto-processing has been done for this date

  // Relations
  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Ensure one record per user per date
  @@unique([userId, date])
}

model DailyTimeRecordTemporary {
  id     String            @id @default(cuid())
  date   DateTime
  status DailyRecordStatus @default(PRESENT)

  requiredCheckIn   DateTime?
  requiredCheckOut  DateTime?
  requiredBreakTime String?

  actualCheckIn   DateTime?
  actualCheckOut  DateTime?
  actualBreakTime String?

  requiredActiveTime        String?
  actualActiveTime          String?
  officialOvertimeundertime String?
  requestedOvertime         String?
  requestedOTstart          DateTime?
  requestedOTend            DateTime?
  overtimeUndertime         String?

  lateCheckInMinutes Int?   @default(0)
  lateCheckInPenalty Float? @default(0)

  autoDeductedLeaveType String?
  isProcessed           Boolean @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}

enum NotificationType {
  TIMELINE_GENERATION_FAILED
  TIMELINE_BACKFILL_COMPLETED
  PROFILE_UPDATE_REQUEST
  LEAVE_APPLICATION_PENDING
  INCREMENT_REMINDER
  WALLET_REQUEST_PENDING
  LOAN_APPLICATION_PENDING
  EMPLOYEE_REGISTRATION_PENDING
  PAYROLL_NOTIFICATION
  SYSTEM_ALERT
  DEADLINE_REMINDER
  OVERTIME_REQUEST_PENDING
}

enum NotificationStatus {
  UNREAD
  READ
}

enum BreakingNoticeTargetType {
  ALL_EMPLOYEES
  SINGLE_EMPLOYEE
  SINGLE_BRANCH
}

enum ProfileUpdateStatus {
  PENDING
  APPROVED
  REJECTED
}

model AdminNotification {
  id       String             @id @default(cuid())
  type     NotificationType
  title    String
  message  String
  status   NotificationStatus @default(UNREAD)
  metadata Json? // For storing additional data

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BreakingNotice {
  id         String                   @id @default(cuid())
  title      String
  targetType BreakingNoticeTargetType

  senderId String
  sender   User   @relation("BreakingNoticeSender", fields: [senderId], references: [id], onDelete: Cascade)

  targetUserId String?
  targetUser   User?   @relation("BreakingNoticeTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)

  targetBranchId String?
  targetBranch   Branch? @relation("BreakingNoticeTargetBranch", fields: [targetBranchId], references: [id], onDelete: SetNull)

  version  Int     @default(1)
  isEdited Boolean @default(false)

  recipients BreakingNoticeRecipient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([targetType])
  @@index([senderId])
  @@index([targetUserId])
  @@index([targetBranchId])
}

model BreakingNoticeRecipient {
  id String @id @default(cuid())

  noticeId String
  notice   BreakingNotice @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("BreakingNoticeRecipientUser", fields: [userId], references: [id], onDelete: Cascade)

  status        Boolean   @default(false)
  seenAt        DateTime?
  visibleUntil  DateTime?
  noticeVersion Int       @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([noticeId, userId])
  @@index([userId, status, visibleUntil])
}

model OvertimePayout {
  id                      String    @id @default(cuid())
  year                    Int
  baseSalary              Float
  totalRequiredActiveTime String
  totalRequiredBreakTime  String
  totalOvertimeUndertime  String
  totalRequiredMinutes    Int
  totalOvertimeMinutes    Int
  calculatedAmount        Int
  isPaid                  Boolean   @default(false)
  paidAt                  DateTime?
  paidBy                  String?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, year])
}

model ProfileUpdateRequest {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  status ProfileUpdateStatus @default(PENDING)

  // Store the requested changes as JSON
  // This allows us to store only the fields that are being updated
  requestedChanges Json

  // Optional: Store previous values for audit trail
  previousValues Json?

  // Admin review info
  reviewedBy  String? // Clerk ID of admin who reviewed
  reviewedAt  DateTime?
  reviewNotes String? // Optional notes from admin

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Employee Notification Model
model EmployeeNotification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  type            String // Type of notification (e.g., "AUTO_LEAVE_DEDUCTION", "LEAVE_APPROVED", etc.)
  title           String // Short title for the notification
  message         String // Detailed message
  relatedDate     DateTime? // Date related to the notification (e.g., date leave was deducted)
  relatedEntityId String? // ID of related entity (leave application, etc.)

  isRead Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Audit Log Model for tracking all automatic leave operations
model LeaveAuditLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  action      String // Action performed (e.g., "AUTO_LEAVE_DEDUCTION", "WEEKLY_OFF_SET", etc.)
  description String // Detailed description of what happened

  // Leave-related details
  affectedDate    DateTime // The date this action was taken for
  leaveTypeId     String? // ID of leave type affected (if applicable)
  leaveType       LeaveType? @relation(fields: [leaveTypeId], references: [id])
  previousBalance Int? // Previous leave balance before action
  newBalance      Int? // New leave balance after action
  deductedDays    Int? // Number of days deducted (if applicable)

  // Processing details
  processedAt      DateTime @default(now()) // When this action was processed
  processingSource String   @default("SYSTEM") // Source of processing (SYSTEM, MANUAL, etc.)

  // Additional metadata
  metadata Json? // Additional data related to the action

  createdAt DateTime @default(now())
}

// Overtime Request Model for employee-initiated overtime requests
model OvertimeRequest {
  id String @id @default(cuid())

  // Employee who is requesting
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Request details
  overtimeDate     DateTime // The date for which overtime is being requested
  totalOvertime    String // Requested overtime duration in HH:MM format
  requestedOTstart DateTime? // Requested overtime start time
  requestedOTend   DateTime? // Requested overtime end time
  reason           String // Reason for overtime
  taskNo           String? // Optional task/project reference

  // Status tracking
  status OvertimeRequestStatus @default(PENDING)

  // Review details
  reviewedBy             String? // Clerk ID of admin who reviewed
  reviewedAt             DateTime?
  declineReason          String? // Reason for declining (if declined)
  // Manager verification fields
  managerVerifiedAt      DateTime?
  managerVerifiedById    String?
  managerVerifiedBy      User?     @relation("OvertimeRequestManagerVerification", fields: [managerVerifiedById], references: [id])
  managerRejectionReason String?
  managerComments        String?

  // Admin decline fields (after manager verified)
  adminDeclinedReason String?
  adminDeclinedAt     DateTime?

  // Timestamps
  requestedAt     DateTime @default(now())
  statusUpdatedAt DateTime @updatedAt

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TimelineModificationRequest {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("TimelineModificationRequester", fields: [userId], references: [id])

  requestedDate      DateTime
  requestedCheckIn   DateTime?
  requestedCheckOut  DateTime?
  requestedBreakTime String?
  reason             String?

  status       TimelineModificationRequestStatus @default(PENDING)
  reviewedById String?
  reviewedBy   User?                             @relation("TimelineModificationReviewer", fields: [reviewedById], references: [id])
  reviewerNote String?
  reviewedAt   DateTime?
  appliedAt    DateTime?

  actionLogs TimelineModificationActionLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, requestedDate])
  @@index([status])
}

model TimelineModificationActionLog {
  id            String @id @default(cuid())
  actionType    String
  actionDetails String
  metadata      Json?

  actorId      String
  actor        User   @relation("TimelineModificationActionActor", fields: [actorId], references: [id])
  targetUserId String
  targetUser   User   @relation("TimelineModificationActionTarget", fields: [targetUserId], references: [id])

  requestId         String?
  request           TimelineModificationRequest? @relation(fields: [requestId], references: [id])
  dailyTimeRecordId String?

  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([requestId])
}

// Employee Notes: free-text notes attached to an employee, visible to Admin and Manager only
model EmployeeNote {
  id         String @id @default(cuid())
  employeeId String
  employee   User   @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  note String

  createdBy     String
  createdByUser User   @relation("EmployeeNoteCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([employeeId])
  @@index([createdBy])
}

// ==================== Notification Engine — Database Foundation ====================
// Implements the schema described in NotificationEngineDesign.md.
// Phase 1 (this migration) is database-only: no worker, service, Server Action, or UI
// code exists yet. AdminNotification/EmployeeNotification/EmailConfig/SystemControlSettings
// are deliberately left untouched — they remain the in-app channel and the legacy single-
// provider email config respectively (see design §9, §31).

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  PUSH
  SLACK
  TEAMS
  IN_APP_ADMIN
  IN_APP_EMPLOYEE
}

enum NotificationJobStatus {
  QUEUED
  PROCESSING
  SENT
  RETRY_SCHEDULED
  FAILED
  DEAD_LETTER
  COMPLETED
}

enum AttemptOutcome {
  SUCCESS
  FAILURE
}

enum NotificationProviderHealthStatus {
  HEALTHY
  DEGRADED
  DOWN
}

enum DocumentStatus {
  PENDING_GENERATION
  GENERATED_LOCAL
  UPLOADING
  UPLOADED
  GENERATION_FAILED
  UPLOAD_FAILED
}

// Durable, idempotent record of "a notifiable thing happened" (design §6).
model NotificationEvent {
  id                String  @id @default(cuid())
  eventType         String // e.g. "LOAN_APPROVED" — free-form, growing catalog (matches EmployeeNotification.type precedent)
  dedupeKey         String  @unique // e.g. "LOAN_APPROVED:{loanId}" — first layer of duplicate prevention (design §17)
  payload           Json?
  sourceDomain      String // Which actions.ts domain raised this event, e.g. "loan"
  triggeredByUserId String? // Plain string, no FK — matches the existing AuditLog.userId precedent

  jobs NotificationJob[]

  createdAt DateTime @default(now())

  @@index([eventType])
  @@index([createdAt])
}

// One unit of delivery work: one recipient, one channel, one event (design §5, §16, §19, §23).
model NotificationJob {
  id String @id @default(cuid())

  eventId String
  event   NotificationEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  channel          NotificationChannel
  recipientUserId  String?
  recipient        User?               @relation(fields: [recipientUserId], references: [id], onDelete: SetNull)
  recipientAddress String // Denormalized snapshot of the address/target actually sent to

  idempotencyKey String @unique // `${dedupeKey}:${channel}:${recipientUserId}` — second layer of duplicate prevention (design §17)

  status        NotificationJobStatus @default(QUEUED)
  attemptCount  Int                   @default(0)
  maxAttempts   Int                   @default(5)
  nextAttemptAt DateTime              @default(now())

  // Crash-recovery lease fields (design §19) — reclaimed by the reaper sweep when lockedAt is stale
  lockedAt DateTime?
  lockedBy String?

  documentId String?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  deliveryAttempts NotificationDeliveryAttempt[]

  // Phase 12 (Notification Center) — virtual back-relation only, required by
  // Prisma to declare NotificationJobInboxState's FK; produces NO migration
  // SQL for this table (verified — see NotificationCenterReport.md).
  inboxStates NotificationJobInboxState[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, nextAttemptAt]) // worker claim query
  @@index([status, lockedAt]) // crash-recovery reaper query
  @@index([eventId])
  @@index([recipientUserId])
  @@index([channel, status])
  @@index([createdAt])
}

// Immutable per-attempt log — full delivery history reconstructable independent of job.status (design §3, §10).
model NotificationDeliveryAttempt {
  id String @id @default(cuid())

  jobId String
  job   NotificationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  providerId String?
  provider   NotificationProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)

  attemptNumber Int
  outcome       AttemptOutcome
  errorCode     String?
  errorMessage  String?

  attemptedAt DateTime @default(now())

  @@index([jobId, attemptNumber])
  @@index([providerId])
}

// Versioned subject/body content per event type per channel (design §7, §22, §32 — append-style history like BaseSalary).
model NotificationTemplate {
  id               String              @id @default(cuid())
  key              String // Matches NotificationEvent.eventType
  channel          NotificationChannel
  subjectTemplate  String? // Not applicable to every channel (e.g. Slack has no subject)
  bodyTemplateHtml String?
  bodyTemplateText String?
  version          Int                 @default(1)
  isActive         Boolean             @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, channel, version])
  @@index([key, channel, isActive])
}

// One configured delivery account with failover priority + health tracking (design §9, §10).
model NotificationProvider {
  id                  String                           @id @default(cuid())
  channel             NotificationChannel
  name                String // Human-readable label, e.g. "Primary Gmail SMTP"
  priority            Int                              @default(1) // Lower = tried first
  configEncrypted     String // AES-256-GCM via existing src/lib/crypto.ts — reuses EMAIL_SECRET_KEY, no new secret key introduced
  isActive            Boolean                          @default(true)
  healthStatus        NotificationProviderHealthStatus @default(HEALTHY)
  consecutiveFailures Int                              @default(0)
  lastFailureAt       DateTime?

  deliveryAttempts NotificationDeliveryAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([channel, priority])
  @@index([channel, healthStatus])
}

// Per-user opt-in/opt-out for a notification type + channel combination (design §6, §31).
model NotificationPreference {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  notificationType String // Matches NotificationEvent.eventType
  channel          NotificationChannel
  isEnabled        Boolean             @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, notificationType, channel])
  @@index([userId])
}

// Singleton runtime configuration (design §16, §25, §36, §40) — same id:"global" pattern as
// SystemControlSettings/EmailConfig; env vars are not involved (engine config is DB-only from day one).
model NotificationSettings {
  id String @id @default("global")

  workerPollIntervalSeconds Int @default(10)
  workerBatchSize           Int @default(20)

  retryBaseDelaySeconds Int   @default(30)
  retryMaxDelaySeconds  Int   @default(3600)
  retryMaxAttempts      Int   @default(5)
  retryJitterRatio      Float @default(0.2)

  completedRetentionDays  Int @default(90)
  deadLetterRetentionDays Int @default(180)

  emailChannelEnabled    Boolean @default(true)
  smsChannelEnabled      Boolean @default(false)
  whatsappChannelEnabled Boolean @default(false)
  pushChannelEnabled     Boolean @default(false)
  slackChannelEnabled    Boolean @default(false)
  teamsChannelEnabled    Boolean @default(false)

  updatedById    String?
  updatedByEmail String?
  updatedByRole  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Phase 12 (Notification Center) — purely additive per-recipient UI state
// (read/archived/deleted) for a NotificationJob. Deliberately a separate side
// table rather than columns on NotificationJob/NotificationEvent: those two
// models are frozen Notification Engine infrastructure (Phases 1–11); this
// state is presentation-layer only and QueueEngine/WorkerRuntime/TemplateEngine/
// DeliveryManager/NotificationService never read or write it. A row is only
// created lazily, the first time a recipient interacts with a job (marks it
// read/archived) — a job with no row here is implicitly unread, unarchived,
// not deleted (see NotificationCenterReport.md).
model NotificationJobInboxState {
  id String @id @default(cuid())

  notificationJobId String
  notificationJob   NotificationJob @relation(fields: [notificationJobId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  isRead     Boolean   @default(false)
  readAt     DateTime?
  isArchived Boolean   @default(false)
  archivedAt DateTime?

  // Soft delete (matches EmployeeNote's existing deletedAt convention) — only
  // ever set for an already-archived notification (see "Delete archived
  // notification" in NotificationCenterReport.md).
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([notificationJobId, userId])
  @@index([userId, isRead])
  @@index([userId, isArchived])
  @@index([userId, deletedAt])
}

// One generated file's lifecycle: local generation → Drive upload (design §11–§15).
model Document {
  id             String         @id @default(cuid())
  type           String // e.g. "PAYSLIP", "OFFER_LETTER", "EMI_SCHEDULE" — free-form, open-ended catalog
  sourceEntityId String // Plain string, no FK — Document can describe any domain entity; matches the
  // AuditLog.userId / TimelineModificationActionLog.dailyTimeRecordId precedent
  // for polymorphic, non-enforced references (see DATABASE.md)
  status         DocumentStatus @default(PENDING_GENERATION)

  localTempPath String?
  driveFileId   String?
  driveFileUrl  String?

  generatedAt DateTime?
  uploadedAt  DateTime?

  notificationJobs NotificationJob[]
  uploadAttempts   DocumentUploadAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([sourceEntityId])
  @@index([type, status])
}

// Immutable per-attempt log for Drive uploads (design §15).
model DocumentUploadAttempt {
  id String @id @default(cuid())

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  attemptNumber Int
  outcome       AttemptOutcome
  errorMessage  String?

  attemptedAt DateTime @default(now())

  @@index([documentId, attemptNumber])
}
